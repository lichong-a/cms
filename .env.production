# 数据库配置（由 RIC_* 环境变量拼接）
DATABASE_URL=postgresql://${RIC_PG_USER}:${RIC_PG_PASSWORD}@${RIC_PG_IP}:${RIC_PG_PORT}/cms

# Redis配置（由 RIC_* 环境变量拼接）
REDIS_URL=redis://:${RIC_REDIS_PASSWORD}@${RIC_REDIS_IP}:${RIC_REDIS_PORT}

# Elasticsearch配置（由 RIC_* 环境变量拼接）
ES_HOST=${RIC_ES_IP}:${RIC_ES_PORT}
ES_USER=${RIC_ES_USER}
ES_PASSWORD=${RIC_ES_PASSWORD}

# JWT配置 (生产环境必须修改)
JWT_SECRET=change-this-in-production-use-strong-random-string
JWT_EXPIRES_IN=7d

# 加密密钥 (生产环境必须修改)
ENCRYPTION_KEY=change-this-to-32-characters-encryption-key

# 应用配置
NODE_ENV=production
PORT=3002
FRONTEND_URL=http://192.168.31.185

# 前端配置
NEXT_PUBLIC_API_URL=http://192.168.31.185/api
NEXT_PUBLIC_APP_NAME=CMS内容管理系统
NEXT_PUBLIC_APP_URL=http://192.168.31.185

# 文件上传
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760
