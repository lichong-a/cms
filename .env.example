# 数据库配置（由 RIC_* 环境变量拼接）
DATABASE_URL=postgresql://${RIC_PG_USER}:${RIC_PG_PASSWORD}@${RIC_PG_IP}:${RIC_PG_PORT}/cms

# Redis配置（由 RIC_* 环境变量拼接）
REDIS_URL=redis://:${RIC_REDIS_PASSWORD}@${RIC_REDIS_IP}:${RIC_REDIS_PORT}

# Elasticsearch配置（由 RIC_* 环境变量拼接）
ES_HOST=${RIC_ES_IP}:${RIC_ES_PORT}
ES_USER=${RIC_ES_USER}
ES_PASSWORD=${RIC_ES_PASSWORD}

# JWT配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 加密密钥（32字符）
ENCRYPTION_KEY=your-32-character-encryption-key

# 应用配置
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3003/api/v1
ALLOWED_DEV_ORIGINS=

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 邮件配置（可选）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# 监控（可选）
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
