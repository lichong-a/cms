{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* 目标环境 */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    
    /* 输出 */
    "outDir": "./dist",
    "tsBuildInfoFile": "./.tsbuildinfo",
    
    /* 路径别名 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/routes/*": ["./src/routes/*"],
      "@/controllers/*": ["./src/controllers/*"],
      "@/services/*": ["./src/services/*"],
      "@/middleware/*": ["./src/middleware/*"],
      "@/models/*": ["./src/models/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/config/*": ["./src/config/*"],
      "@cms/types": ["../../packages/types/src"],
      "@cms/utils": ["../../packages/utils/src"],
      "@cms/config": ["../../packages/config/src"]
    },
    
    /* Express 5 支持 */
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma", "src/__tests__/**"]
}
