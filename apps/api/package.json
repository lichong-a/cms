{
  "name": "@cms/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "build": "tsc -p tsconfig.build.json --noCheck",
    "start": "node dist/bootstrap.js",
    "lint": "eslint . --cache",
    "typecheck": "tsc --noEmit",
    "db:generate": "tsx src/scripts/run-prisma.ts generate",
    "db:migrate": "tsx src/scripts/run-prisma.ts migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "tsx src/scripts/run-prisma.ts studio",
    "db:push": "tsx src/scripts/run-prisma.ts db push",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/__tests__/integration",
    "test:services": "vitest run src/__tests__/services",
    "test-oss": "tsx src/scripts/test-oss.ts"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "@cms/config": "workspace:*",
    "@cms/types": "workspace:*",
    "@cms/utils": "workspace:*",
    "@prisma/client": "^6.0.0",
    "ali-oss": "^6.23.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.1",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-elasticsearch": "^8.1.0",
    "pino-pretty": "^13.1.3",
    "redis": "^5.11.0",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.15",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.18",
    "nodemon": "^3.1.14",
    "prisma": "^6.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
